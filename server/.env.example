# 本地开发可用 SQLite；云托管请改成 MySQL 连接串
DATABASE_URL=sqlite:///./gather.db
# MySQL 示例（微信云托管内网）:
# DATABASE_URL=mysql+pymysql://root:你的密码@内网地址:3306/gather?charset=utf8mb4

JWT_SECRET=change-me-to-a-long-random-string
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# 微信小程序（必填才能真实登录 / 取手机号）
# AppID 与小程序 manifest 中 mp-weixin.appid 一致，例如 wxc85b8624dd75e61c
WX_APPID=wxc85b8624dd75e61c
WX_SECRET=

# 云托管监听端口，本地可用 8000
PORT=80
