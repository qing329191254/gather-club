# 本地开发可用 SQLite；云托管请改成 MySQL 连接串
DATABASE_URL=sqlite:///./gather.db
# MySQL 示例（微信云托管内网）:
# DATABASE_URL=mysql+pymysql://root:你的密码@内网地址:3306/gather?charset=utf8mb4

JWT_SECRET=change-me-to-a-long-random-string
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# 微信小程序（必填才能真实登录 / 取手机号）
# AppID 与小程序 manifest 中 mp-weixin.appid 一致，例如 wxc85b8624dd75e61c
WX_APPID=wxc85b8624dd75e61c
WX_SECRET=

# 微信支付商户（APIv2，配置后金额>0 的订单走真实 JSAPI 支付）
WX_MCH_ID=
WX_MCH_KEY=
# 支付结果通知回调，需公网可访问，例如 https://your.domain/api/v1/pay/notify
WX_NOTIFY_URL=

# 微信云托管对象存储（后台上传图片，仅云存储不落盘）
# 必填：WX_APPID + WX_SECRET + WX_CLOUD_ENV
# 若改用云调用令牌：控制台「云调用 → 微信令牌权限」需添加 /tcb/uploadfile
WX_CLOUD_ENV=prod-d7gemg7fe0004adc9
COS_BUCKET=7072-prod-d7gemg7fe0004adc9-1492244999
COS_REGION=ap-shanghai
COS_CDN_DOMAIN=https://7072-prod-d7gemg7fe0004adc9-1492244999.tcb.qcloud.la

# 云托管监听端口，本地可用 8000
PORT=80
